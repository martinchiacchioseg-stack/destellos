name: Prode & Liga AFA Auto-Sync

on:
  schedule:
    # Viernes a las 15:00 UTC (12:00 Argentina) - Publicar fixture fin de semana
    - cron: '0 15 * * 5'
    # Sábados y Domingos cada 2 horas entre 17:00 y 01:00 UTC - Liquidación de resultados
    - cron: '0 17,19,21,23,1 * * 0,6'
    # Lunes a las 03:00 UTC (00:00 Argentina) - Cierre final y tabla
    - cron: '0 3 * * 1'
  workflow_dispatch: # Permite ejecución manual desde la pestaña Actions de GitHub

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Clonar repositorio
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          pip install -r scripts/requirements.txt

      - name: Ejecutar sincronización de Prode y Liga
        env:
          RAPIDAPI_KEY: ${{ secrets.RAPIDAPI_KEY }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL || 'https://hzysabgjbcypfydeigkh.supabase.co' }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh6eXNhYmdqYmN5cGZ5ZGVpZ2toIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MjIxMjk2OSwiZXhwIjoyMTA3Nzg4OTY5fQ.2te043w-UVmprA-cPwBfeICOofkw9mM_6V-ojWKVXyk' }}
          APP_BASE_URL: ${{ secrets.APP_BASE_URL || 'https://destellos.vercel.app' }}
        run: python scripts/prode_sync.py
