# ===== Destellos — variables de entorno (Vercel > Settings > Environment Variables) =====
# Todas son SOLO de servidor, salvo que se indique lo contrario. Nunca se exponen al cliente.

# Supabase (obligatorio): Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sesión (obligatorio): cadena aleatoria de 32+ caracteres  ->  openssl rand -base64 48
SESSION_SECRET=

# Superadmin (obligatorio). El hash es bcrypt, nunca la clave en texto plano.
#   node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE', 12))"
# En Vercel escapar cada $ del hash como \$ si se carga desde .env
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=

# Gemini (obligatorio para veredicto, trivia, Arlequín)
GEMINI_API_KEY=

# Email (recomendado: recuperación de clave y avisos al administrador) — Resend
RESEND_API_KEY=
MAIL_FROM="Destellos <no-reply@tu-dominio.com>"

# Cron de Vercel (protege /api/cron/*)
CRON_SECRET=
